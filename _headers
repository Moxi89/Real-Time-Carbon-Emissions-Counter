/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' https: data:; connect-src 'self' https://static.cloudflareinsights.com
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Content-Type: text/html; charset=utf-8

/*.css
  Content-Type: text/css; charset=utf-8

/*.js
  Content-Type: text/javascript; charset=utf-8
